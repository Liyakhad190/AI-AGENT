# ---------------------------------------------------------------------------
# AI Voice Agent — environment configuration
# Copy this file to .env and fill in real values for production.
# NEVER commit real secrets to source control.
# ---------------------------------------------------------------------------

APPLICATION_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
APP_SECRET_KEY=change-me-to-a-long-random-secret
ENCRYPTION_KEY=change-me-to-a-long-encryption-secret

DATABASE_URL=sqlite+aiosqlite:///./dev.db
# For production PostgreSQL: postgresql+asyncpg://user:pass@host:5432/db
REDIS_URL=

# --- Telephony (Twilio or mock) ---
# Set TELEPHONY_PROVIDER=twilio for real outbound calls; "mock" for dev (no real calls).
TELEPHONY_PROVIDER=mock
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_SECRET=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_WEBHOOK_SECRET=
VERIFIED_DESTINATION_NUMBER=

# --- Voice engine ---
# "mock" for dev; replace with a real-time voice provider (e.g. OpenAI Realtime, Azure, etc.)
VOICE_PROVIDER=mock
VOICE_API_KEY=
VOICE_MODEL=gpt-4o-realtime-preview
VOICE_NAME=alloy

# --- LLM / STT / TTS (Strategy B modular pipeline) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

STT_PROVIDER=mock
STT_API_KEY=

TTS_PROVIDER=mock
TTS_API_KEY=

# --- Google OAuth (Gmail / Calendar) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/oauth/callback

# --- Limits ---
MAX_CALL_DURATION_SECONDS=600
MAX_DAILY_CALLS=10
MAX_CONCURRENT_CALLS=3
MONTHLY_BUDGET_LIMIT=50.0

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ALGORITHM=HS256
